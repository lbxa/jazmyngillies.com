---

<BaseLayout
  title="Portfolio — Jazmyn Gillies"
  heading="Portfolio"
  description="Short-form social content with tens of millions of views, plus music video production for London Alley and award-winning long-form documentary."
  ogImage="/og/og-portfolio.jpg"
>
  <section class="relative z-10 flex min-h-0 flex-1 flex-col">
    <div class="flex items-baseline justify-between gap-4 pb-4 md:pb-5">
      <div
        role="tablist"
        aria-label="Portfolio sections"
        class="flex items-baseline gap-5 md:gap-7"
      >
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              class="border-b border-transparent pb-1 text-[12px] uppercase tracking-[0.28em] text-[#f2eadc]/35 transition-colors duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] hover:text-[#f2eadc]/70 aria-selected:border-white aria-selected:text-white md:text-[14px]"
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {/* Tracking this wide runs into the gutter on a 375px screen. */}
      <span
        class="hidden text-right text-[9px] uppercase tracking-[0.14em] text-[#f2eadc]/40 sm:inline sm:text-[10px] sm:tracking-[0.22em] md:text-[12px]"
      >
        Filmed &amp; edited by Jazmyn
      </span>
    </div>

    {
      /* Each panel owns its scroll axis: the short-form grid runs down, the
        long-form gallery runs across. That is why the scroller lives inside
        the panels rather than wrapping both. */
    }
    <div
      role="tabpanel"
      id="panel-short"
      aria-labelledby="tab-short"
      class="flex min-h-0 flex-1 flex-col"
    >
      <div
        data-embed-scroller
        class="min-h-0 flex-1 overflow-y-auto overscroll-contain [mask-image:linear-gradient(to_bottom,transparent_0,black_14px,black_calc(100%-28px),transparent_100%)]"
      >
        <div
          class="columns-2 gap-2 pb-10 sm:columns-3 md:gap-3 lg:columns-4 xl:columns-5"
        >
          {shortForm.map((clip) => <TikTokEmbed {...clip} />)}
        </div>
      </div>
    </div>

    <div
      role="tabpanel"
      id="panel-long"
      aria-labelledby="tab-long"
      data-exhibition
      hidden
      class="relative flex min-h-0 flex-1 flex-col"
    >
      {
        /* snap-mandatory so a card always settles square in the frame rather
          than stranding two half-cards, which is what makes it read as a wall
          of plates instead of a scrolling strip. */
      }
      <div
        data-exhibit-track
        class="flex min-h-0 flex-1 snap-x snap-mandatory gap-6 overflow-x-auto overflow-y-hidden overscroll-x-contain pb-2 [scrollbar-width:none] md:gap-10 [mask-image:linear-gradient(to_right,black_calc(100%-56px),transparent_100%)] [&::-webkit-scrollbar]:hidden"
      >
        {
          longForm.map((item, index) => (
            <ExhibitionCard {...item} index={index} total={longForm.length} />
          ))
        }
      </div>

      {
        /* Overlaid on the artwork's left and right edges rather than parked in
          a row underneath it. Down there they sat below the fold of the eye and
          read as page furniture -- here they are where a carousel is reached
          for, and the vertical offset is measured from the still itself so they
          never drift onto the caption.

          Disabled ends stay visible but faded: a lone arrow at the first card
          is what tells you the row moves at all. */
      }
      {
        [
          {
            key: "prev",
            label: "Previous work",
            side: "left-0 md:left-1",
            d: "M19 12H6M12 6l-6 6 6 6",
          },
          {
            key: "next",
            label: "Next work",
            side: "right-0 md:right-1",
            d: "M5 12h13M12 6l6 6-6 6",
          },
        ].map((control) => (
          <button
            type="button"
            data-exhibit-prev={control.key === "prev" ? true : undefined}
            data-exhibit-next={control.key === "next" ? true : undefined}
            aria-label={control.label}
            class:list={[
              "absolute z-20 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-black/55 text-white/85 backdrop-blur-sm transition duration-300 ease-[cubic-bezier(0.25,0.1,0.25,1)] hover:border-white/70 hover:bg-black/80 hover:text-white disabled:pointer-events-none disabled:opacity-25 md:h-12 md:w-12",
              "top-[var(--exhibit-arrow-top,50%)]",
              control.side,
            ]}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="h-4 w-4 md:h-5 md:w-5"
            >
              <path d={control.d} />
            </svg>
          </button>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { initLazyEmbeds } from "../scripts/lazy-embeds";
  import { initExhibition } from "../scripts/exhibition";
  import { initTabs } from "../scripts/tabs";

  let teardown: (() => void) | undefined;
  let initialisedRoot: HTMLElement | null = null;

  /**
   * Same shape as the home page carousel: idempotent, because on a client-side
   * navigation this module is fetched and run *after* astro:page-load has
   * already fired, so the event alone would never initialise the first visit.
   */
  const sync = () => {
    const section =
      document
        .querySelector<HTMLElement>("[role='tablist']")
        ?.closest("section") ?? null;

    if (section === initialisedRoot) {
      return;
    }

    teardown?.();

    if (!section) {
      teardown = undefined;
      initialisedRoot = null;
      return;
    }

    const stops: Array<() => void> = [];

    // Both scrollers: the grid runs down, the gallery runs across, and the
    // preload margin in lazy-embeds applies to every edge to cover both.
    section
      .querySelectorAll<HTMLElement>(
        "[data-embed-scroller], [data-exhibit-track]",
      )
      .forEach((scroller) => stops.push(initLazyEmbeds(scroller)));

    const exhibition = section.querySelector<HTMLElement>("[data-exhibition]");

    if (exhibition) {
      stops.push(initExhibition(exhibition));
    }

    const tablist = section.querySelector<HTMLElement>("[role='tablist']");

    if (tablist) {
      stops.push(
        initTabs(tablist, (panel) => {
          // Panels keep their own scroll position, so a tab that is returned to
          // would otherwise open part-way through the previous visit.
          panel?.querySelector("[data-embed-scroller]")?.scrollTo({ top: 0 });
          panel?.querySelector("[data-exhibit-track]")?.scrollTo({ left: 0 });
        }),
      );
    }

    teardown = () => stops.forEach((stop) => stop());
    initialisedRoot = section;
  };

  const reset = () => {
    teardown?.();
    teardown = undefined;
    initialisedRoot = null;
  };

  sync();
  document.addEventListener("astro:page-load", sync);
  document.addEventListener("astro:before-swap", reset);
</script>
